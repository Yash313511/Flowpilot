# ============================================================
# FlowPilot Environment Configuration
# Duplicate this file to .env.local for local development,
# or set these in your hosting provider (Vercel, Railway, etc.)
# ============================================================

# 1. MongoDB Connection String (MongoDB Atlas or local)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/flowpilot?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/flowpilot?retryWrites=true&w=majority

# 2. NextAuth Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET=generate-a-secure-random-32-char-secret-for-production

# 3. Application Canonical URL
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXTAUTH_URL=http://localhost:3000

# 4. Google Gemini AI Configuration
AI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-2.5-flash

# 5. Optional Google OAuth (Leave empty if only using email/password login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
